{
  "name": "@quentinadam/uint8array-extension",
  "version": "0.1.5",
  "description": "A library of Uint8Array extension functions",
  "license": "MIT",
  "author": "Quentin Adam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinadam/deno-uint8array-extension.git"
